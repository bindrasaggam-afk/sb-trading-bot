<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- MAIN CONTENT AREA (Dashboard) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Bar with Toggle Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:padding="12dp">

            <TextView
                android:id="@+id/btnToggleDrawer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☰ MENU"
                android:textColor="#FFC107"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnToggleDrawer"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:text="SB TRADING BOT"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Scrollable Dashboard Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Connected (Local Backend)"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <!-- MCX Commodities Section -->
                <TextView
                    android:id="@+id/sectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MCX COMMODITIES (17 CONTRACTS)"
                    android:textColor="#FFC107"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/commodityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/equityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- SIDE PANEL (Expandable / Collapsible Drawer) -->
    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#181818"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SB BOT PANEL"
            android:textColor="#FFC107"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/menuCommodities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 MCX Commodities (17)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="#262626"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/menuEquities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📈 Equity Watchlist"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/menuFutures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 3-Month Futures"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/menuOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Options (CE / PE)"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp" />

        <TextView
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Settings / API"
            android:textColor="#888888"
            android:textSize="16sp"
            android:padding="12dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
